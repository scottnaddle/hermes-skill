# Copy to /etc/hermes-mac/daou-hosts.env (mode 644) and load via EnvironmentFile= drop-in.
# Plugins have NO host defaults; unset => hop unhealthy / opencode hop error.
DAOU_MAC_HOST=<user>@<mac-tailscale-ip>
DAOU_MAC_API=http://<mac-tailscale-ip>:8650
DAOU_MAC_WORK=/Users/<user>/ubion-bot-work
DAOU_FALLBACK_HOST=root@<fallback-vps-ip>
# optional: DAOU_OPENCODE_HOST (defaults to DAOU_FALLBACK_HOST), DAOU_OPENCODE_KEY
